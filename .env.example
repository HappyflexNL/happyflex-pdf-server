# Gedeeld secret tussen happyflex-app en deze service. Verplicht, minimaal 32 tekens.
# Genereren: openssl rand -hex 32
# Zet de echte waarde in Coolify-env, nooit in deze repo.
RENDER_SERVICE_TOKEN=

# Alles hieronder is optioneel; de getoonde waarden zijn de defaults uit src/config.js.
# PORT=3000
# MAX_BODY_BYTES=5242880
# RENDER_TIMEOUT_MS=20000
# MAX_CONCURRENT_RENDERS=2
# RETRY_AFTER_SECONDS=5
# SHUTDOWN_GRACE_MS=15000

# Alleen voor lokaal draaien buiten het image: pad naar een Chrome op deze machine.
# In het image lost puppeteer de browser zelf op uit PUPPETEER_CACHE_DIR.
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
